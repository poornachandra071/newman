      "name": "FirstPage",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const items = pm.response.json();\r\n\r\nconst schema = {\r\n  type: \"object\",\r\n  required: [\"postId\", \"id\", \"name\", \"email\", \"body\"],\r\n  properties: {\r\n    postId: { type: \"integer\" },\r\n    id:     { type: \"integer\" },\r\n    name:   { type: \"string\" },\r\n    email:  { type: \"string\" },\r\n    body:   { type: \"string\" }\r\n  }\r\n};\r\n\r\npm.test(\"Status is 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Response time under 1500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(1500));\r\npm.test(\"Content-Type is JSON\", () =>\r\n  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));\r\n\r\npm.test(\"Returns exactly 50 records\", () => pm.expect(items).to.be.an(\"array\").with.lengthOf(50));\r\npm.test(\"First page holds ids 1 to 50\", () =>\r\n  pm.expect(items.map(c => c.id)).to.eql(Array.from({ length: 50 }, (_, i) => i + 1)));\r\npm.test(\"No duplicate ids\", () =>\r\n  pm.expect(new Set(items.map(c => c.id)).size).to.eql(items.length));\r\npm.test(\"Every record matches the schema\", () => {\r\n  items.forEach(c => pm.expect(c).to.have.jsonSchema(schema));\r\n});\r\npm.test(\"Emails look valid\", () =>\r\n  items.forEach(c => pm.expect(c.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)));\r\npm.test(\"Total count header is 500\", () =>\r\n  pm.expect(pm.response.headers.get(\"X-Total-Count\")).to.eql(\"500\"));"
            ]
          }
        }
      ],
