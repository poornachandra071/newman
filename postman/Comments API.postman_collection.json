    {
      "name": "walkAllThePages",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const baseUrl = pm.variables.get(\"baseUrl\");\r",
              "const limit = 50;\r",
              "const maxPages = 30;          // safety stop, so a bug can't loop forever\r",
              "const all = [];\r",
              "\r",
              "function fetchPage(page) {\r",
              "  pm.sendRequest(`${baseUrl}/comments?_page=${page}&_limit=${limit}`, (err, res) => {\r",
              "    pm.test(`page ${page} returned 200`, () => {\r",
              "      pm.expect(err).to.be.null;\r",
              "      pm.expect(res.code).to.eql(200);\r",
              "    });\r",
              "    if (err || res.code !== 200) return;\r",
              "\r",
              "    const items = res.json();\r",
              "    all.push(...items);\r",
              "\r",
              "    if (items.length === limit && page < maxPages) {\r",
              "      fetchPage(page + 1);\r",
              "    } else {\r",
              "      verify();\r",
              "    }\r",
              "  });\r",
              "}\r",
              "\r",
              "function verify() {\r",
              "  const ids = all.map(c => c.id);\r",
              "\r",
              "  pm.test(\"All 500 records fetched\", () => pm.expect(all).to.have.lengthOf(500));\r",
              "  pm.test(\"No duplicates across pages\", () => pm.expect(new Set(ids).size).to.eql(ids.length));\r",
              "  pm.test(\"No gaps: ids run 1 to 500\", () =>\r",
              "    pm.expect(ids).to.eql(Array.from({ length: 500 }, (_, i) => i + 1)));\r",
              "  pm.test(\"Every record has the required fields\", () =>\r",
              "    all.forEach(c => [\"postId\", \"id\", \"name\", \"email\", \"body\"].forEach(f => pm.expect(c).to.have.property(f))));\r",
              "}\r",
              "\r",
              "fetchPage(1);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/comments?_page=1&_limit=50",
          "host": [
