    {
      "name": "paginationBoundaries",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              " const baseUrl = pm.variables.get(\"baseUrl\");\r",
              "const cases = [\r",
              "  { page: 1,   limit: 50,  expected: 50 },\r",
              "  { page: 10,  limit: 50,  expected: 50 },\r",
              "  { page: 11,  limit: 50,  expected: 0 },\r",
              "  { page: 1,   limit: 1,   expected: 1 },\r",
              "  { page: 500, limit: 1,   expected: 1 },\r",
              "  { page: 501, limit: 1,   expected: 0 },\r",
              "  { page: 1,   limit: 500, expected: 500 }\r",
              "];\r",
              "\r",
              "cases.forEach(c => {\r",
              "  pm.sendRequest(`${baseUrl}/comments?_page=${c.page}&_limit=${c.limit}`, (err, res) => {\r",
              "    pm.test(`page=${c.page} limit=${c.limit} returns ${c.expected} records`, () => {\r",
              "      pm.expect(err, \"request error\").to.be.null;\r",
              "      pm.expect(res.code).to.eql(200);\r",
              "      pm.expect(res.json()).to.be.an(\"array\").with.lengthOf(c.expected);\r",
              "    });\r",
              "  });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/comments?_page=1&_limit=1",
          "host": [
